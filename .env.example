# Copia este archivo como .env.local (local) o pon estas variables en Vercel.
# Están en Supabase › Project Settings › API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# SECRETA: nunca la publiques ni la pongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Dirección pública del sitio, sin "/" al final.
# Mientras pruebas: la que te da Vercel. Después: https://afterhourmx.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
